{
  "name": "scriptgen",
  "private": true,
  "version": "0.1.0",
  "description": "Éditeur visuel de scripts Lua pour MizanBot (application locale)",
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "data": "node scripts/build-data.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "luaparse": "^0.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  }
}
